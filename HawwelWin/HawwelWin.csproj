<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Hawwel</AssemblyName>
    <RootNamespace>Hawwel</RootNamespace>
    <ApplicationIcon>Assets\hawwel.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Hawwel</Product>
    <Company>Ashraf</Company>
    <Description>Fix text typed with the wrong keyboard layout (English/Arabic)</Description>
    <Copyright>Copyright (c) Ashraf</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF و WinForms مع بعض بيعملوا ambiguity (Clipboard/Application/DataObject...) -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Resource Include="Assets\hawwel.ico" />
  </ItemGroup>

</Project>
