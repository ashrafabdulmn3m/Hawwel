    "about.desc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حوّل الكلام المكتوب بالكيبورد الغلط بضغطة اختصار، في أي برنامج."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fix text typed in the wrong keyboard layout with one shortcut, in any app."
          }
        }
      }
