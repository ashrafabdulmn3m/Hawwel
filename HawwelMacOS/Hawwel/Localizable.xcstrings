    },
    "about.log.3": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صوت خفيف اختياري، والكيبورد بيتغيّر للغة الصح بعد التحويل"
          }
