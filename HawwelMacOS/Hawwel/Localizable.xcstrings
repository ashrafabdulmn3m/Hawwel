    "about.log.1": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed converting text in Adobe apps (Photoshop, Illustrator, InDesign, Premiere, After Effects)"
