    <item>
      <title>Version 1.3.1</title>
      <pubDate>Sun, 22 Nov 2026 16:14:00 +0200</pubDate>
      <sparkle:version>6</sparkle:version>
      <sparkle:shortVersionString>1.3.1</sparkle:shortVersionString>
      <sparkle:minimumSystemVersion>14.6</sparkle:minimumSystemVersion>
      <description><![CDATA[
        <ul>
          <li>New menu bar icon with the Hawwel logo, adapts to light and dark menu bars</li>
          <li>New round Light / Dark toggle at the top of the window</li>
          <li>Correct conversion with Apple's "Arabic" layout: Hawwel now uses the keyboards you have enabled</li>
          <li>Keyboard changes take effect right away, no restart needed</li>
          <li>Pressing the shortcut twice quickly no longer causes overlapping conversions</li>
        </ul>
      ]]></description>
